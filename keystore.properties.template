# Copy this file to `keystore.properties` and fill in real values.
# `keystore.properties` is gitignored — never commit real credentials.
#
# To create a release keystore:
#   keytool -genkey -v -keystore healthify-release.jks \
#           -keyalg RSA -keysize 2048 -validity 10000 -alias healthify
#
# Then place the .jks somewhere outside the repo (e.g. ~/.android/keystores/)
# and point `storeFile` at its absolute path.

storeFile=/absolute/path/to/healthify-release.jks
storePassword=CHANGE_ME
keyAlias=healthify
keyPassword=CHANGE_ME
