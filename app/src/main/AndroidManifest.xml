<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ── Network ─────────────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- ── Notifications ───────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- ── Health Connect ──────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />

    <!-- ── Strip Firebase-injected advertising-ID + AdServices permissions ─
         Firebase Analytics's manifest declares com.google.android.gms.permission.AD_ID
         and the modern Privacy-Sandbox AdServices permissions
         (ACCESS_ADSERVICES_AD_ID, ACCESS_ADSERVICES_ATTRIBUTION). The
         manifest merger pulls all three into our APK by default.
         Healthify is marketed as "no trackers, no ads" and the Play Data
         Safety form declares no advertising data collection, so we
         explicitly remove every ad-related permission here. Firebase
         Analytics still functions — it just can't attribute events to
         the advertising ID for demographics. -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_TOPICS"
        tools:node="remove" />

    <application
        android:name=".HealthifyApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Healthify">

        <!-- ── Main Activity ─────────────────────────────────────────── -->
        <!--
          Launch theme is the system splash style; MainActivity.onCreate()
          calls installSplashScreen() so the Activity swaps to Theme.Healthify
          (the postSplashScreenTheme) as soon as the first frame is ready.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.App.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ── Health Connect: required for permission usage screen ──── -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- ── Health Connect privacy policy metadata ─────────────────── -->
        <!--
          URL must be live HTTPS before any Health Connect permission UI is
          shown. Currently served from the repo's own GitHub Pages site —
          see docs/privacy/index.html. If you buy a real `healthify.app`
          domain later, point a CNAME at deltapkr.github.io and either:
          (a) configure the custom domain in the repo's Pages settings, or
          (b) change this URL to the new host.
        -->
        <meta-data
            android:name="health_connect_request_permissions_privacy_policy_url"
            android:value="https://deltapkr.github.io/Healthify/privacy/" />

        <!-- ── Reminder alarm receiver ─────────────────────────────────── -->
        <!--
          No <intent-filter> needed: AlarmManager delivers via an explicit
          PendingIntent that targets this receiver class directly, so
          exported=false + class-name routing is sufficient. The action
          string in the Intent is still used as a key inside onReceive().
        -->
        <receiver
            android:name=".notifications.ReminderReceiver"
            android:exported="false" />

        <!-- ── Boot receiver: re-schedule alarms after reboot/upgrade ──── -->
        <!--
          BOOT_COMPLETED fires AFTER the user unlocks the device, so the
          Room database (Credential-Encrypted storage) is available. We
          deliberately do NOT request LOCKED_BOOT_COMPLETED — that would
          fire pre-unlock when the DB is still encrypted and reads fail.
          TIME_SET / TIMEZONE_CHANGED rebuild the alarm schedule if the
          user changes clock or timezone; MY_PACKAGE_REPLACED re-arms
          after the app updates.
        -->
        <receiver
            android:name=".notifications.BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
